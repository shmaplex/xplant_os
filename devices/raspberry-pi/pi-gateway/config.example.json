{
  "device_token": "xpd_live_YOUR_TOKEN_HERE",
  "device_id": "YOUR_DEVICE_UUID",
  "xplant_base_url": "https://app.xplantpro.com",
  "sensors": [
    { "type": "temperature", "unit": "C",  "gpio_pin": 4 },
    { "type": "humidity",    "unit": "%",  "gpio_pin": 4 }
  ],
  "reading_interval_seconds": 60,
  "heartbeat_interval_seconds": 300,
  "batch_flush_interval_seconds": 300,
  "batch_max_readings": 100,
  "batch_buffer_limit": 5000,
  "simulate": false
}
